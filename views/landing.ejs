                </div>
                <div class="coming-card" data-aos>
                    <div class="coming-icon">🛒</div>
                    <h3 class="coming-title">Marketplace</h3>
                    <p class="coming-desc">Compra y venta entre usuarios. Inmuebles, autos y mas.</p>
                </div>
                <div class="coming-card" data-aos>
                    <div class="coming-icon">💳</div>
                    <h3 class="coming-title">Pagos</h3>
                    <p class="coming-desc">Pagos integrados, splits y transferencias entre usuarios.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="section-container">
            <div class="cta-content" data-aos>
                <h2 class="cta-title">Unite a Austra</h2>
                <p class="cta-desc">Gratis para siempre. Registrate en segundos y empeza a usar todos los modulos.</p>
                <% if (isAuthenticated) { %>
                    <a href="/dashboard" class="btn btn-primary btn-lg">Ir al Dashboard</a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary btn-lg">Crear cuenta gratis</a>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="section-container">
            <div class="footer-top">
                <div class="footer-brand">
                    <span class="footer-logo">AUSTRA</span>
                    <p class="footer-tagline">Tu super app para Uruguay.</p>
                </div>
                <div class="footer-links">
                    <div class="footer-col">
                        <h4 class="footer-col-title">Plataforma</h4>
                        <a href="/dashboard">Dashboard</a>
                        <a href="/forum">Foro</a>
                        <a href="/pricing">Planes</a>
                    </div>
                    <div class="footer-col">
                        <h4 class="footer-col-title">Legal</h4>
                        <a href="/privacy">Privacidad</a>
                        <a href="/terms">Terminos</a>
                        <a href="mailto:info.austra@protonmail.com">Contacto</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; <%= new Date().getFullYear() %> Austra, una empresa de <a href="https://dokta.cc/" target="_blank" rel="noopener noreferrer">DOKTA</a>. Hecho en Uruguay.</span>
            </div>
        </div>
    </footer>

    <script>
        // Scroll-triggered fade-in animations
        (function() {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('aos-visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

            document.addEventListener('DOMContentLoaded', function() {
                document.querySelectorAll('[data-aos]').forEach(function(el) {
                    observer.observe(el);
                });
            });
        })();

        // Simulated live stats (replace with real API calls)
        (function() {
            function animateValue(el, value) {
                if (el) el.textContent = value;
            }
            // Placeholder values - connect to your real data endpoints
            setTimeout(function() {
                animateValue(document.getElementById('stat-usd'), '$41.20');
                animateValue(document.getElementById('stat-usd-sell'), '$43.50');
                animateValue(document.getElementById('stat-temp'), '18°C');
                animateValue(document.getElementById('stat-btc'), '$67,240');
            }, 800);
        })();

        // Hamburger / logout handlers for authenticated users
        document.addEventListener('DOMContentLoaded', function() {
            var logoutLinks = document.querySelectorAll('a[href="/auth/logout"]');
            logoutLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    localStorage.clear();
                    sessionStorage.clear();
                    window.location.href = '/auth/logout';
                });
            });
        });
    </script>
</body>
</html>
